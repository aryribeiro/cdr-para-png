# Smoke test no mesmo tipo de ambiente do Streamlit Cloud: Debian, os pacotes
# do packages.txt instalados por apt e o requirements.txt por pip. Prova que o
# LibreOffice do Debian lê CDR (libcdr) e que a suíte passa em Linux.
# Uso: docker build -f tests/Dockerfile.smoke -t cdr-smoke . && docker run --rm cdr-smoke
FROM python:3.12-slim-bookworm
WORKDIR /app
COPY packages.txt .
RUN apt-get update \
 && xargs -a packages.txt apt-get install -y --no-install-recommends \
 && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt pytest
COPY . .
RUN soffice --version
CMD ["python", "-m", "pytest", "-q", "-p", "no:cacheprovider"]
